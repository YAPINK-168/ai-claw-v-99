void Line_off(void)   //关掉运行电机
{
	 Mgruntime=0;
	 resetflay=0;
	 OutShopBusy=0;
	 MgStoptime=0;
	 Out_sflay=0;
	 Mgdelayflay=0;
	#if Yiputen==1
	  Lie1=0;Lie2=0;Lie3=0;Lie4=0;Lie5=0;Lie6=0;Lie7=0;Lie8=0;Lie9=0;Lie10=0;//关列
	  Han1=1;Han2=1;Han3=1;Han4=1;Han5=1;Han6=1;Han7=1;Han8=1;Han9=1;Han10=1;//关行
	#else
   GPIOB->BRR|=GPIO_Pin_3|GPIO_Pin_4|GPIO_Pin_5|GPIO_Pin_6|GPIO_Pin_7;//0
   GPIOC->BSRR|=GPIO_Pin_12;//1
   GPIOD->BRR|=GPIO_Pin_7;//0
	 GPIOD->BSRR|=GPIO_Pin_0|GPIO_Pin_1|GPIO_Pin_2|GPIO_Pin_3|GPIO_Pin_4|GPIO_Pin_5|GPIO_Pin_6;//
	 GPIOE->BRR|=GPIO_Pin_2|GPIO_Pin_3|GPIO_Pin_4|GPIO_Pin_5;//0
	#endif
}


void OotOK(void)//报成功
{
		if(Outoverflay==5)
		{
			 Outoverflay=0;
			 Com.Res.Bits.B4=1; 
		}
		else Com.Res.Bits.B5=1; 
}


void Line_good (void) //出货成功  
{
   if(Line_go)//出货成功
		{
			if(mode==0x11)
			{
				       if(MgTime<1000&&!Mgdelay)MgTime++;

				       if(MgTime>40)
							 {
				            MgTime=0;
										Line_go=0;
								    MgStoptime=0;
										Line_ok=0;
										Line_off();//关掉MOS管
								    if(Outoverflay==0)
										{
												Outoverflay=5;
											
												OutShopBusy=1;
												mode=0;
												star=0;
												Mgruntime=0;
												Out_sflay=0x23;//检测有没有到位
												Shopoutstart=1;
										
										}
//										Com.Res.Bits.B4=1; 
										Mgruntime=0;
							 }
				
			}
			else
			{
				  MgTime++;
				  if(MgTime>40)
					{
							Line_go=0;
							Line_ok=0;
							Line_off();//关掉MOS管
							Mgruntime=0;
							Mgdelay=0;
						  OotOK();
					}
			}
		}
}

void NomgError(u8 p)//电机报错
{

     
		 Line_off();//关掉MOS管
		 Errornum=p;
	   Com.Res.Bits.B3=1;

}




